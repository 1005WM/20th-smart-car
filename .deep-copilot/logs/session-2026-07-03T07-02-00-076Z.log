{
    turn_tick++;
    float diff = 1.0f * fabsf(weighted_error);
    if(diff > BASE_SPEED - 10.0f)  diff = BASE_SPEED - 10.0f;  // 保证右轮 ≥ 10
    // ... 其余不变 ...
}
```

