```c
int judge_up_if_all_black()
{
    int contine_black = 0;
    int col_start = MT9V03X_1_W / 2 - 20;
    int col_end   = MT9V03X_1_W / 2 + 20;

    for (int h = MT9V03X_1_H - 5; h > MT9V03X_1_H - 15; h--)   // ← 扫底部
