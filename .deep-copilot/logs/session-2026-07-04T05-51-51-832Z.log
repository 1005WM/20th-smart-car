### 第一步：加一个带行范围的 Otsu

在 `Otsu()` 后面加：

```c
uint8 Otsu_Block(uint8 image[MT9V03X_1_H][MT9V03X_1_W], int start_row, int end_row)
{
    uint8 image_temp = 0;
    uint8 threhold   = 0;
    int   block_h    = end_row - start_row;
    float totalpixel = (float)(block_h * MT9V03X_1_W);

    // 清零
    for (int i = 0; i < 256; i++)
    {
        P[i]    = 0;
        PK[i]   = 0;
        MK[i]   = 0;
        huidu[i] = 0;
    }

    // 直方图（只扫指定行 + 中间 50% 列，排除背景干扰）
    int col_start = MT9V03X_1_W / 4;
    int col_end   = MT9V03X_1_W * 3 / 4;
    for (int i = start_row; i < end_row; i++)
    {
        for (int j = col_start; j < col_end; j++)
        {
            image_temp = image[i][j];
            huidu[image_temp]++;
        }
    }

    // 重新算总像素（因为列也只取了中间 50%）
    totalpixel = (float)(block_h * (col_end - col_start));

    // 累计概率和累计均值（和原来一样）
    float sumPK = 0;
    float sumMK = 0;
    for (int i = 0; i < 256; i++)
    {
        P[i]  = (float)huidu[i] / totalpixel;
        PK[i] = sumPK + P[i];
        sumPK = PK[i];
        MK[i] = sumMK + i * P[i];
        sumMK = MK[i];
    }

    // 最大类间方差
    float wondvalue = 0;
    float value    = 0;
    for (int i = 5; i < 245; i++)
    {
        wondvalue = ((MK[255] * PK[i] - MK[i]) * (MK[255] * PK[i] - MK[i]))
                  / (PK[i] * (1 - PK[i]));
        if (wondvalue > value)
        {
            value    = wondvalue;
            threhold = i;
        }
    }

    if (threhold < Ostu_threhold_min)
        threhold = Ostu_threhold_min;

    return threhold;
}
```

