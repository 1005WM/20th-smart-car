## 策略 1：前瞻加权 — 远处权重大

原代码对所有行平均，改为远处行权重更高：

```c
// 原代码：
// sum_midline += (mid_line[i] - Actual_centerline);
// float error = sum_midline / (actual_start_line - actua_end_line);

// 改为加权：
float total_weight = 0;
float weighted_sum = 0;
for(uint8 i = actual_start_line; i >= actua_end_line; i--)
{
    // 行号越小（越远）权重越大，120行权重0.3，50行权重1.0
    float weight = 1.0f - 0.7f * (float)(i - actua_end_line) / (float)(actual_start_line - actua_end_line);
    weighted_sum += (float)(mid_line[i] - Actual_centerline) * weight;
    total_weight += weight;
}
float error = weighted_sum / total_weight;
```

权重分布：
```
行 120（最近）→ weight = 0.3    近处偏差小，低权重防止微调过度
行 85  （中间）→ weight = 0.65
行 50  （最远）→ weight = 1.0    远处偏差大，高权重保证弯道预判一致
```

---

## 策略 2：滑动平均 — 跨帧稳定

在 `image.c` 顶部加一个静态变量，`Deviation()` 每次调用做低通滤波：

```c
// 文件顶部加：
static float deviation_filtered = 0;
static uint8 deviation_inited = 0;

// Deviation() 尾部改为：
float Deviation()
{
    const int Actual_centerline = MT9V03X_1_W / 2;
    float actual_start_line = MT9V03X_1_H - 30;
    float actua_end_line = 50;

    float total_weight = 0;
    float weighted_sum = 0;
    for(uint8 i = actual_start_line; i >= actua_end_line; i--)
    {
        float weight = 1.0f - 0.7f * (float)(i - actua_end_line) / (float)(actual_start_line - actua_end_line);
        weighted_sum += (float)(mid_line[i] - Actual_centerline) * weight;
        total_weight += weight;
    }
    float raw_error = weighted_sum / total_weight;

    // 滑动平均滤波（首次直接赋值）
    if(deviation_inited == 0)
    {
        deviation_filtered = raw_error;
        deviation_inited = 1;
    }
    else
    {
        deviation_filtered = 0.4f * raw_error + 0.6f * deviation_filtered;
    }

    return deviation_filtered / 1.5f;
}
```

效果：
```
帧1: 偏差=20  → 输出=20        (首次)
帧2: 偏差=35  → 输出=26        (异常跳变被压制)
帧3: 偏差=30  → 输出=27.6      (趋于稳定)
```

---

## 策略 3：动态前瞻点 — 速度快看得更远

将 `actua_end_line` 从固定 50 改为根据速度动态调整：

```c
float Deviation()
{
    const int Actual_centerline = MT9V03X_1_W / 2;
    float actual_start_line = MT9V03X_1_H - 30;  // 行 90（固定近端）

    // 动态远端：速度越快，看得越远（行号越小）
    float avg_speed = (float)(motor_L.encoder_speed + motor_R.encoder_speed) / 2.0f;
    // 速度 0 → end_line=70（近），速度 800 → end_line=30（远）
    float actua_end_line = 70.0f - (avg_speed / 800.0f) * 40.0f;
    if(actua_end_line < 30)  actua_end_line = 30;
    if(actua_end_line > 70)  actua_end_line = 70;

    // ... 加权求和 + 滤波同上 ...
}
```

---

## 三合一最终版 `Deviation()`

```c
// 文件顶部新增两个静态变量
static float deviation_filtered = 0;
static uint8 deviation_inited = 0;

float Deviation()
{
    const int Actual_centerline = MT9V03X_1_W / 2;
    float actual_start_line = MT9V03X_1_H - 30;

    // 策略3：动态前瞻点
    float avg_speed = (float)(motor_L.encoder_speed + motor_R.encoder_speed) / 2.0f;
    float actua_end_line = 70.0f - (avg_speed / 800.0f) * 40.0f;
    if(actua_end_line < 30)  actua_end_line = 30;
    if(actua_end_line > 70)  actua_end_line = 70;

    // 策略1：加权求和
    float total_weight = 0;
    float weighted_sum = 0;
    for(uint8 i = actual_start_line; i >= actua_end_line; i--)
    {
        float weight = 1.0f - 0.7f * (float)(i - actua_end_line)
                       / (float)(actual_start_line - actua_end_line);
        weighted_sum += (float)(mid_line[i] - Actual_centerline) * weight;
        total_weight += weight;
    }
    float raw_error = weighted_sum / total_weight;

    // 策略2：滑动平均
    if(deviation_inited == 0)
    {
        deviation_filtered = raw_error;
        deviation_inited = 1;
    }
    else
    {
        deviation_filtered = 0.4f * raw_error + 0.6f * deviation_filtered;
    }

    return deviation_filtered / 1.5f;
}
```

