### 二、`connect.c` — 用 `weighted_error` 直接算轮速

```c
#include "image.h"
#include "motor.h"
#include "zf_common_headfile.h"


#define BASE_SPEED            70.0f

/* 弯道轮速差参数 */
#define TURN_GAIN             2.0f    // weighted_error(像素) → 轮速差 的增益
#define TURN_MIN_DIFF         15.0f   // 最小差速，保证能转起来
#define TURN_MAX_DIFF         50.0f   // 最大差速，防止翻车

#define TURN_MIN_TICK         20
#define TURN_MAX_TICK         110
#define TURN_EXIT_ERROR       6.0f


typedef enum
{
    follow_state = 0,
    turn_left_state = 3,
    turn_right_state = 4,
    turn_back_state = 5,
} driver_state;

driver_state Go = follow_state;

static uint16 turn_tick = 0;


void state_machine(void)
{
    int order = judge_where();        // 会更新 weighted_error
    float error = Deviation();

    switch(Go)
    {
        case follow_state:
        {
            turn_tick = 0;

            if(order == 3)
            {
                Go = turn_left_state;
            }
            else if(order == 4)
            {
                Go = turn_right_state;
            }

            break;
        }

        case turn_left_state:
        {
            turn_tick++;

            /* ★ 直接用 weighted_error 算轮速差 */
            float diff = TURN_GAIN * fabsf(weighted_error);
            if(diff > TURN_MAX_DIFF) diff = TURN_MAX_DIFF;
            if(diff < TURN_MIN_DIFF) diff = TURN_MIN_DIFF;

            pid_speed_L.target = BASE_SPEED - diff;   // 左轮慢
            pid_speed_R.target = BASE_SPEED + diff;   // 右轮快

            if(turn_tick > TURN_MIN_TICK)
            {
                if((error > -TURN_EXIT_ERROR && error < TURN_EXIT_ERROR)
                   || turn_tick > TURN_MAX_TICK)
                {
                    Go = follow_state;
                    turn_tick = 0;
                }
            }

            break;
        }

        case turn_right_state:
        {
            turn_tick++;

            /* ★ 右转：右轮慢，左轮快 */
            float diff = TURN_GAIN * fabsf(weighted_error);
            if(diff > TURN_MAX_DIFF) diff = TURN_MAX_DIFF;
            if(diff < TURN_MIN_DIFF) diff = TURN_MIN_DIFF;

            pid_speed_L.target = BASE_SPEED + diff;
            pid_speed_R.target = BASE_SPEED - diff;

            if(turn_tick > TURN_MIN_TICK)
            {
                if((error > -TURN_EXIT_ERROR && error < TURN_EXIT_ERROR)
                   || turn_tick > TURN_MAX_TICK)
                {
                    Go = follow_state;
                    turn_tick = 0;
                }
            }

            break;
        }

        default:
        {
            Go = follow_state;
            turn_tick = 0;
            break;
        }
    }
}
```

