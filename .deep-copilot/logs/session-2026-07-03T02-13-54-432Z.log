[2026-07-03T03:14:35.955Z] [ASSISTANT] 最长白列是一种完全不同的搜线思路：**不依赖灰度跳变，而是统计每列的连续白点长度**。赛道区域的列白点多且连续，赛道外的列白点少或零散。

```cpp
// ====== 最长白列扫线 ======
// 在二值图上统计每列的最长连续白段，从中确定赛道左右边界

#define WHITE_MIN_LEN   15      // 一列至少连续15个白点才算赛道
#define TRACK_MIN_WIDTH 20      // 赛道至少20列宽，防止误判

int16 lbc_leftline[MT9V03X_1_H];   // 最长白列法左边界
int16 lbc_rightline[MT9V03X_1_H];  // 最长白列法右边界
int16 lbc_centerline[MT9V03X_1_H]; // 最长白列法中线

void longest_white_column(void)
{
    int col_white[MT9V03X_1_W];      // 每列的最长连续白段
    int col_start[MT9V03X_1_W];      // 每列最长白段的起始行
    int col_end[MT9V03X_1_W];        // 每列最长白段的结束行

    // ====== 第1步：逐列统计最长连续白段 ======
    for (int c = 0; c < MT9V03X_1_W; c++)
    {
        int max_len = 0, cur_len = 0;
        int cur_start = 0, best_start = 0, best_end = 0;

        for (int r = 0; r < MT9V03X_1_H; r++)
        {
            if (imageindex[r][c] == 255)
            {
                if (cur_len == 0) cur_start = r;
                cur_len++;
            }
            else
            {
                if (cur_len > max_len)
                {
                    max_len    = cur_len;
                    best_start = cur_start;
                    best_end   = r - 1;
                }
                cur_len = 0;
            }
        }
        if (cur_len > max_len)
        {
            max_len    = cur_len;
            best_start = cur_start;
            best_end   = MT9V03X_1_H - 1;
        }
        col_white[c] = max_len;
        col_start[c] = best_start;
        col_end[c]   = best_end;
    }

    // ====== 第2步：找出白段最长的列作为赛道中心参考 ======
    int best_col  = MT9V03X_1_W / 2;
    int best_len  = 0;
    for (int c = 0; c < MT9V03X_1_W; c++)
    {
        if (col_white[c] > best_len)
        {
            best_len = col_white[c];
            best_col = c;
        }
    }

    // ====== 第3步：从最长白列向左右找边界 ======
    int left_bound  = best_col;
    int right_bound = best_col;

    // 向左找：连续白段长度跌到阈值以下就是边界
    for (int c = best_col - 1; c >= 0; c--)
    {
        if (col_white[c] >= WHITE_MIN_LEN)
            left_bound = c;
        else
            break;
    }

    // 向右找
    for (int c = best_col + 1; c < MT9V03X_1_W; c++)
    {
        if (col_white[c] >= WHITE_MIN_LEN)
            right_bound = c;
        else
            break;
    }

    // ====== 第4步：逐行填充边界（利用 col_start/col_end 确定每行有效范围） ======
    for (int r = 0; r < MT9V03X_1_H; r++)
    {
        int row_left  = -1;
        int row_right = -1;

        // 在 [left_bound - 5, right_bound + 5] 范围内逐列检查有效行
        int L = (left_bound  - 5 > 0) ? left_bound  - 5 : 0;
        int R = (right_bound + 5 < MT9V03X_1_W) ? right_bound + 5 : MT9V03X_1_W - 1;

        for (int c = L; c <= R; c++)
        {
            // 该列的有效白段覆盖了当前行
            if (col_white[c] >= WHITE_MIN_LEN && r >= col_start[c] && r <= col_end[c])
            {
                if (row_left < 0) row_left = c;
                row_right = c;
            }
        }

        lbc_leftline[r]  = row_left;
        lbc_rightline[r] = row_right;
        if (row_left >= 0 && row_right >= 0)
            lbc_centerline[r] = (row_left + row_right) / 2;
        else
            lbc_centerline[r] = -1;
    }
}
```

---

### 与差比和的对比

| | 差比和 | 最长白列 |
|---|---|---|
| 输入 | 灰度原图 | 二值图 `imageindex` |
| 原理 | 相邻像素灰度差/和 | 逐列统计连续白点 |
| 优点 | 亚像素精度 | 极度鲁棒，不丢线 |
| 缺点 | 光照/对比度敏感 | 依赖二值化质量 |
| 弯道 | 边界可能搜不到 | 只要白列够长就能找到 |

---

### 两种融合方式

**方式A：差比和为主，最长白列为兜底**

```cpp
void image_boundary_process(void)
{
    // ... 差比和逻辑不变 ...
    // 当某行两边都丢了 → 用最长白列的结果补
    if (leftline[row] < 0 && rightline[row] < 0)
    {
        if (lbc_centerline[row] >= 0)
        {
            centerline[row] = lbc_centerline[row];
            leftline[row]  = lbc_leftline[row];
            rightline[row] = lbc_rightline[row];
        }
    }
}
```

**方式B：直接用最长白列替代差比和**

把 `image_invocation()` 里加入 `longest_white_column()`，`line_control()` 直接用 `lbc_centerline[]` 算偏差。

