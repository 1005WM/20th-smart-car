#include "connect.h"
#include "image.h"
#include "motor.h"
#include "zf_common_headfile.h"

driver_state Go = follow_state;

#define BASE_SPEED          70.0f

#define TURN_MIN_TICK       20
#define TURN_MAX_TICK       110
#define CROSS_TURN_MAX_TICK 200     // ★ 十字直角转弯超时更长（2秒）
#define TURN_EXIT_ERROR     6.0f
#define CROSS_INNER_SPEED   5.0f    // ★ 内侧轮最低速度（几乎停转）

static uint16 turn_tick = 0;
static float  turn_weighted_error = 0;
static uint8  turn_is_cross = 0;    // ★ 标记是否十字直角转弯
static uint8  exit_stable_cnt = 0;  // ★ 退出前连续稳定计数

// ... what_control() 不变 ...

uint8 state_machine(void)
{
    int order = judge_where();
    float error = Deviation();

    switch(Go)
    {
        case follow_state:
        {
            turn_tick = 0;
            turn_is_cross = 0;
            exit_stable_cnt = 0;
            line_pid.Kp = 1.0f;
            line_pid.Kd = 1.0f;
            line_pid.output_limit = 30.0f;

            // --- 普通右转 ---
            if(order == 4 && distance >= 20 && distance <= 25)
            { turn_weighted_error = weighted_error; Go = turn_right_state; return 1; }
            if(order == 4 && distance >= 28 && distance <= 35)
            { turn_weighted_error = weighted_error; Go = turn_right_state; return 1; }

            // --- 普通左转 ---
            if(order == 3 && distance >= 37 && distance <= 46)
            { turn_weighted_error = weighted_error; Go = turn_left_state; return 1; }

            // --- 十字直角右转 ---
            if(order == 8 && distance >= 45 && distance <= 54)
            {
                turn_weighted_error = 60.0f;   // 固定最大偏差，直角
                turn_is_cross = 1;
                Go = turn_right_state;
                return 1;
            }

            return 0;
        }

        case turn_left_state:
        {
            turn_tick++;
            float diff = turn_is_cross
                       ? (BASE_SPEED - CROSS_INNER_SPEED)    // 十字：内侧接近停转
                       : 0.7f * fabsf(turn_weighted_error);  // 普通：按偏差比例

            pid_speed_L.target = BASE_SPEED - diff;
            pid_speed_R.target = BASE_SPEED + diff;

            if(turn_tick > TURN_MIN_TICK)
            {
                // 退出条件：赛道回正 + 连续稳定 N 帧
                uint16 max_tick = turn_is_cross ? CROSS_TURN_MAX_TICK : TURN_MAX_TICK;
                if(error > -TURN_EXIT_ERROR && error < TURN_EXIT_ERROR)
                {
                    exit_stable_cnt++;
                    if(exit_stable_cnt >= 5)    // 连续5帧稳定才退出
                    {
                        Go = follow_state;
                        turn_tick = 0;
                    }
                }
                else exit_stable_cnt = 0;

                if(turn_tick > max_tick)
                {
                    Go = follow_state;
                    turn_tick = 0;
                }
            }
            return 1;
        }

        case turn_right_state:
