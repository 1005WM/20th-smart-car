## 2. 新增三个函数 — 加在 `follow_bianjie()` 之前（约第96行）

```cpp
// ====== 差比和逐行扫线（新增）======

// 向左找边界：从 start_col 往左扫，灰度突变处即为左边界
static void difsum_left(uint8 row, uint8 start_col)
{
    uint8  mov = 2;   // 步长，每隔2像素采样
    leftline[row] = -1;   // 默认未找到
    for (uint8 col = start_col; col >= mov + 1; col -= mov)
    {
        float dif = (float)(mt9v03x_image_1[row][col]
                          - mt9v03x_image_1[row][col - mov - 1]) * 256.0f;
        float sum = (float)(mt9v03x_image_1[row][col]
                          + mt9v03x_image_1[row][col - mov - 1]);
        if (sum < 1.0f) sum = 1.0f;
        if (fabs(dif / sum) > sar_thre)    // 差比和超过阈值 → 边界
        {
            leftline[row] = (int16)(col - mov);
            leftline_num++;
            return;
        }
    }
}

// 向右找边界：从 start_col 往右扫
static void difsum_right(uint8 row, uint8 start_col)
{
    uint8  mov = 2;
    rightline[row] = -1;   // 默认未找到
    for (uint8 col = start_col; col <= MT9V03X_1_W - mov - 1; col += mov)
    {
        float dif = (float)(mt9v03x_image_1[row][col]
                          - mt9v03x_image_1[row][col + mov + 1]) * 256.0f;
        float sum = (float)(mt9v03x_image_1[row][col]
                          + mt9v03x_image_1[row][col + mov + 1]);
        if (sum < 1.0f) sum = 1.0f;
        if (fabs(dif / sum) > sar_thre)
        {
            rightline[row] = (int16)(col + mov);
            rightline_num++;
            return;
        }
    }
}

// 主扫线函数：逐行用差比和找左右边界 → 算中线
void image_boundary_process(void)
{
    uint8  start_col = MT9V03X_1_W / 2;
    leftline_num  = 0;
    rightline_num = 0;

    for (int row = MT9V03X_1_H - 1; row >= 1; row--)
    {
        // 搜索起点：上一行中线低通滤波，平滑跟随
        if (row < MT9V03X_1_H - 1)
            start_col = (uint8)(0.5f * (float)centerline[row + 1]
                              + 0.3f * (float)start_col
                              + 0.2f * (float)(MT9V03X_1_W / 2));

        difsum_left(row, start_col);
        difsum_right(row, start_col);

        // 中线 = 左右边界均值；任一边未找到则用对侧外推
        if (leftline[row] >= 0 && rightline[row] >= 0)
            centerline[row] = (leftline[row] + rightline[row]) / 2;
        else if (leftline[row] >= 0)
            centerline[row] = leftline[row] + 30;   // 只有左边界：右推30像素
        else if (rightline[row] >= 0)
            centerline[row] = rightline[row] - 30;  // 只有右边界：左推30像素
        else
            centerline[row] = (row < MT9V03X_1_H - 1)
                            ? centerline[row + 1]    // 都没找到：沿用下行中线
                            : MT9V03X_1_W / 2;
    }
}
```

