## 完整代码

```c
/*==========================================================================
 * 编码器记步 — 抗噪声版
 * 基于你的 motor.c 现有结构
 *==========================================================================*/

#define wheel_cir             30.0f      // 轮子直径（mm）
#define Encoder_pulse_one     4096.0f    // 每圈脉冲数
#define ENC_FILTER_WEIGHT     0.3f       // raw 低通滤波系数（越小越稳，越大越灵敏）
#define ENC_DEAD_ZONE         8.0f       // 脉冲死区：±8 以内视为噪声
#define ENC_OUTLIER_LIMIT     400.0f     // 单次异常上限：超过此值丢弃整帧

float car_distance = 0.0f;


void Encoder_Data_Get(void)
{
    /*========== 1. 读硬件原始值 ==========*/
    motor_L.encoder_raw = -encoder_get_count(TIM4_ENCODER);  // 左编码器取反（匹配机械方向）
    motor_R.encoder_raw =  encoder_get_count(TIM6_ENCODER);


    /*========== 2. raw 值低通滤波 ==========*/
    /* 目的：单次噪声尖峰被"稀释"，不会直接参与距离累加
     * 公式：滤波值 = 旧值×0.7 + 新值×0.3
     * 假设突然跳进来 500 的噪声：
     *   第1帧：0×0.7 + 500×0.3 = 150
     *   第2帧：150×0.7 + 0×0.3  = 105
     *   第3帧：105×0.7 + 0×0.3  = 73
     * 噪声被逐步衰减，不会造成几千几千的跳变
     */
    motor_L.encoder_raw_filtered = motor_L.encoder_raw_filtered * (1.0f - ENC_FILTER_WEIGHT)
                                 + (float)motor_L.encoder_raw * ENC_FILTER_WEIGHT;
    motor_R.encoder_raw_filtered = motor_R.encoder_raw_filtered * (1.0f - ENC_FILTER_WEIGHT)
                                 + (float)motor_R.encoder_raw * ENC_FILTER_WEIGHT;


    /*========== 3. 速度滤波 ==========*/
    /* 你原来就有的，保留不动。注意这里用 raw（未滤波）更新速度，
     * 因为速度需要响应快；距离用 filtered 版本，需要稳。
     */
    motor_L.encoder_speed = motor_L.encoder_speed * 0.5f + (float)motor_L.encoder_raw * 0.5f;
    motor_R.encoder_speed = motor_R.encoder_speed * 0.5f + (float)motor_R.encoder_raw * 0.5f;


    /*========== 4. 总脉冲累加（用原始值保持精度） ==========*/
    motor_L.total_encoder += motor_L.encoder_raw;
    motor_R.total_encoder += motor_R.encoder_raw;


    /*========== 5. 清零硬件计数器 ==========*/
    encoder_clear_count(TIM4_ENCODER);
    encoder_clear_count(TIM6_ENCODER);


    /*========== 6. 计算中心脉冲增量 ==========*/
    /* 核心公式：(左脉冲 + 右脉冲) / 2 = 车中心走了多少脉冲 */
    float center_delta = (motor_L.encoder_raw_filtered + motor_R.encoder_raw_filtered) / 2.0f;


    /*========== 7. 异常值截断 ==========*/
    /* 正常 5ms 内，即使全速也不会超过 400 脉冲。
     * 超过这个数的必然是接线抖动或噪声尖峰，直接丢弃整帧。
     */
    if(center_delta > ENC_OUTLIER_LIMIT || center_delta < -ENC_OUTLIER_LIMIT)
    {
        return;   // 这帧数据不可信，跳过不累加距离
    }


    /*========== 8. 死区过滤 ==========*/
    /* 编码器静止时 ±1~±3 的微小抖动是正常的。
     * ±8 的死区在距离上相当于：
     *   8 / 4096 × 30 × 3.14 ≈ 0.18mm
     * 远低于系统精度需求，但能彻底消除静止抖动累加。
     */
    if(center_delta > -ENC_DEAD_ZONE && center_delta < ENC_DEAD_ZONE)
    {
        center_delta = 0.0f;
    }


    /*========== 9. 取绝对值（只记路程不记方向） ==========*/
    if(center_delta < 0.0f)
    {
        center_delta = -center_delta;
    }


    /*========== 10. 累加距离 ==========*/
    /* 公式解释：
     *   center_delta / Encoder_pulse_one  → 走了多少圈
     *   × wheel_cir                       → 走了多少毫米（周长 = 直径 × π...）
     *   × 3.14f                           → π
     *
     *   注意：这里用 wheel_cir（直径 30mm）× 3.14 = 周长 94.2mm
     *   如果 wheel_cir 本身就是周长，这里不该×3.14。检查一下你的实际定义。
     */
    car_distance += center_delta / Encoder_pulse_one * wheel_cir * 3.14f;
}


float Encoder_Get_Distance(void)
{
    return car_distance;
}
```

