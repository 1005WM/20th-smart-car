---

### `code/buzzer.h`

```cpp
#ifndef CODE_BUZZER_H_
#define CODE_BUZZER_H_

#include "zf_common_headfile.h"

// ---- 蜂鸣器引脚：P33_9，复用 ATOM1_CH1_P33_9 ----
#define BUZZER_PWM_CH   ATOM1_CH1_P33_9
#define BUZZER_FREQ     2000        // 蜂鸣频率 2kHz，声音最响亮的频段

void buzzer_init(void);             // 初始化蜂鸣器
void buzzer_on(uint32 duty);        // 打开蜂鸣器（duty 0~10000, 5000=50%占空比）
void buzzer_off(void);              // 关闭蜂鸣器
void buzzer_beep(uint16 ms);        // 短促蜂鸣一次（ms 毫秒）

#endif /* CODE_BUZZER_H_ */
```

---

### `code/buzzer.c`

```cpp
#include "buzzer.h"

// ---- 蜂鸣器初始化：上电默认关闭 ----
void buzzer_init(void)
{
    pwm_init(BUZZER_PWM_CH, BUZZER_FREQ, 0);   // 频率2kHz，占空比0=关闭
}

// ---- 打开蜂鸣器，duty 范围 0~PWM_DUTY_MAX(10000) ----
void buzzer_on(uint32 duty)
{
    if(duty > PWM_DUTY_MAX) duty = PWM_DUTY_MAX;
    pwm_set_duty(BUZZER_PWM_CH, duty);
}

// ---- 关闭蜂鸣器 ----
void buzzer_off(void)
{
    pwm_set_duty(BUZZER_PWM_CH, 0);
}

// ---- 蜂鸣 duration_ms 毫秒（阻塞式，仅用于调试） ----
void buzzer_beep(uint16 ms)
{
    buzzer_on(5000);                    // 50%占空比，声音最响
    system_delay_ms(ms);                // 库自带延时，单位毫秒
    buzzer_off();
}
```

---

### 非阻塞版本（推荐，放 `connect.c` 中）

阻塞版会卡住主循环，实际用这个：

```cpp
// ---- 放在 connect.c 顶部 ----
static uint16 beep_timer   = 0;   // 当前蜂鸣剩余时间（ms）
#define  BEEP_SHORT         100   // 短鸣 100ms

// ---- 每10ms调用一次（放 state_machine 里或 ISR 里） ----
static void buzzer_tick(void)
{
    if(beep_timer > 0)
    {
        buzzer_on(5000);             // 蜂鸣中
        beep_timer--;
        if(beep_timer == 0)
            buzzer_off();            // 时间到，关蜂鸣
    }
}

// ---- 触发一次蜂鸣（在需要的地方调用） ----
static void buzzer_start(uint16 ms)
{
    beep_timer = ms / 10;            // 转为10ms tick数
}

// ---- 初始化（在 motor_init 同级调用） ----
void buzzer_init(void)
{
    pwm_init(BUZZER_PWM_CH, BUZZER_FREQ, 0);
}

// ---- 蜂鸣器打开/关闭（同上） ----
static void buzzer_on(uint32 duty)  { pwm_set_duty(BUZZER_PWM_CH, duty); }
static void buzzer_off(void)        { pwm_set_duty(BUZZER_PWM_CH, 0); }
```

---

### 使用示例

```cpp
// cpu0_main.c 初始化阶段
buzzer_init();

// 十字路口识别到时短鸣
if(order == 8)
{
    buzzer_start(BEEP_SHORT);   // 嘀一声
}

// 或直接非阻塞蜂鸣
buzzer_start(500);              // 500ms 长鸣，转弯完成
```

