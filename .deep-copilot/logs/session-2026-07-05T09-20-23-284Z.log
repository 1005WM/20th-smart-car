## 需要改动的文件

### 1. 新建 `code/buzzer.h`

```cpp
#ifndef CODE_BUZZER_H_
#define CODE_BUZZER_H_
#include "zf_common_headfile.h"

#define BUZZ_PIN    P33_9

void buzzer_init(void);
void buzzer_on(void);
void buzzer_off(void);
void buzzer_beep(uint16 ticks);    // ticks 以 10ms 为单位
void buzzer_tick(void);            // 每 10ms 调用一次

#endif
```

### 2. 新建 `code/buzzer.c`

```cpp
#include "buzzer.h"

static uint16 buzz_timer = 0;

void buzzer_init(void)
{
    gpio_init(BUZZ_PIN, GPO, 0, GPO_PUSH_PULL);
}

void buzzer_on(void)  { gpio_high(BUZZ_PIN); }
void buzzer_off(void) { gpio_low(BUZZ_PIN);  }

void buzzer_beep(uint16 ticks)
{
    buzzer_on();
    buzz_timer = ticks;     // 比如 30 → 响 300ms
}

void buzzer_tick(void)
{
    if (buzz_timer > 0)
    {
        buzz_timer--;
        if (buzz_timer == 0)
            buzzer_off();
    }
}
```

### 3. 改动 `code/connect.c`

顶部加一行 include：

```cpp
#include "buzzer.h"
```

`follow_state` 里 5 个转弯分支每处加一行 `buzzer_beep(30)`（以第一个为例）：

