### `code/buzzer.c`

```cpp
#include "buzzer.h"

static uint16 beep_timer = 0;   // 剩余10ms tick数

// ---- 初始化：上电关蜂鸣 ----
void buzzer_init(void)
{
    pwm_init(BUZZER_PWM_CH, BUZZER_FREQ, 0);
}

// ---- 触发蜂鸣，非阻塞 ----
void buzzer_start(uint16 ms)
{
    beep_timer = ms / 10;       // 转为 10ms tick 数
    pwm_set_duty(BUZZER_PWM_CH, 5000);   // 打开，50%占空比
}

// ---- 每10ms调用一次，到时间自动关 ----
void buzzer_tick(void)
{
    if(beep_timer > 0)
    {
        beep_timer--;
        if(beep_timer == 0)
            pwm_set_duty(BUZZER_PWM_CH, 0);   // 时间到，关闭
    }
}
```

